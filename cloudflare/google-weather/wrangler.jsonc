{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "woodshole-google-weather",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-07",
  "triggers": { "crons": ["7,37 * * * *"] },
  "kv_namespaces": [
    { "binding": "FORECASTS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://bezialemma.com,https://www.bezialemma.com"
  }
}
